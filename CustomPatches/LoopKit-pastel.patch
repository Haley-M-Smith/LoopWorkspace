diff --git a/LoopKitUI/ChartColorPalette.swift b/LoopKitUI/ChartColorPalette.swift
index 51dff4c..ff0c558 100644
--- a/LoopKitUI/ChartColorPalette.swift
+++ b/LoopKitUI/ChartColorPalette.swift
@@ -20,6 +20,24 @@ public struct ChartColorPalette {
     /// The chart's surface color, used to cover axis labels while scrubbing.
     public let background: UIColor
 
+    public var pastelInsulinTint: UIColor {
+        Self.pastelTint(light: (116, 67, 151), dark: (200, 162, 232), fallback: insulinTint)
+    }
+
+    public var pastelCarbTint: UIColor {
+        Self.pastelTint(light: (161, 55, 83), dark: (255, 182, 193), fallback: carbTint)
+    }
+
+    private static func pastelTint(light: (CGFloat, CGFloat, CGFloat), dark: (CGFloat, CGFloat, CGFloat), fallback: UIColor) -> UIColor {
+        UIColor { traits in
+            if traits.accessibilityContrast == .high {
+                return fallback.resolvedColor(with: traits)
+            }
+            let (red, green, blue) = traits.userInterfaceStyle == .dark ? dark : light
+            return UIColor(red: red / 255, green: green / 255, blue: blue / 255, alpha: 1)
+        }
+    }
+
     public init(axisLine: UIColor, axisLabel: UIColor, grid: UIColor, presetTint: UIColor, glucoseTint: UIColor, insulinTint: UIColor, carbTint: UIColor, background: UIColor = .systemBackground) {
         self.axisLine = axisLine
         self.axisLabel = axisLabel
